# Copia este archivo como .env. Las claves de MySQL solo se aplican en el PRIMER inicio.
MYSQL_ROOT_PASSWORD=RootEspacio2026_local
INGESTOR_DB_PASSWORD=Ingestor2026_local
DASH_DB_PASSWORD=Lector2026_local

# Clave gratuita en https://api.nasa.gov (llega al correo al instante).
# DEMO_KEY funciona pero permite muy pocas peticiones por hora.
NASA_API_KEY=DEMO_KEY
